{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Browser Manager",
  "version": "0.1.0",
  "identifier": "com.mbm.multi-browser-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Multi Browser Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Manage multiple isolated browser profiles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/0xpostman/multi-browser-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NTM1QzY1QzEzQjI3QkYKUldTL0p6dkJaVnhUK0kwNDducFdEQVQ5TGZNK2NNSjZrTHJWVWs1VUUrU0k5bEFGOUM0cDlZdnEK"
    }
  }
}
